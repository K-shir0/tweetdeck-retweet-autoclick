{
  "manifest_version": 3,
  "name": "Tweetdeck Retweet Clicker",
  "version": "1.0",
  "description": "Clicks the retweet button automatically when retweet icon is clicked.",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
    ],
      "js": ["clicker.js"]
    }
  ],
  "action": {
    "default_icon": "icon.png",
    "default_title": "Retweet Clicker"
  }
}
